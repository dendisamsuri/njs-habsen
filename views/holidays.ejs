<%- include('partials/header') %>
<h1><%= t('nav_holidays') %></h1>
<table>
  <thead>
    <tr><th><%= t('date') %></th><th><%= t('name') %></th></tr>
  </thead>
  <tbody>
    <% rows.forEach(function(r) { %>
      <tr><td><%= r.tanggal %></td><td><%= r.name %></td></tr>
    <% }) %>
    <% if (rows.length === 0) { %><tr><td colspan="2" class="empty"><%= t('empty') %></td></tr><% } %>
  </tbody>
</table>
<%- include('partials/footer') %>
