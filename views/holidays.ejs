<%- include('partials/header') %>
<div class="page-head">
  <div><h1><%= t('nav_holidays') %></h1><p class="sub"><%= rows.length %> hari libur</p></div>
  <div class="page-actions">
    <% if (canEdit) { %><a class="btn primary" href="/ui/holidays/new"><%= t('add') %></a><% } %>
  </div>
</div>
<% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>
<div class="card">
  <div class="table-toolbar"><b>Daftar libur</b><span class="count"><%= rows.length %> <%= t('rows_label') %></span></div>
  <% if (!rows.length) { %><div class="empty"><%= t('empty_holidays') %></div><% } else { %>
  <div class="table-wrap"><table class="tbl">
    <thead><tr><th><%= t('date') %></th><th><%= t('name') %></th><th><%= t('company_label') %></th><th style="text-align:center;"><%= t('actions') %></th></tr></thead>
    <tbody>
      <% rows.forEach(function(r) { %>
        <tr>
          <td class="mono"><%= r.tanggal %></td>
          <td><b><%= r.name %></b></td>
          <td style="font-size:.82rem;"><%= r.company %></td>
          <td style="text-align:center;">
            <% if (canEdit) { %>
            <div class="row-actions">
              <a class="btn" href="/ui/holidays/<%= r.id %>/edit"><%= t('edit') %></a>
              <form method="post" action="/ui/holidays/<%= r.id %>/delete" style="display:inline" onsubmit="return confirm('<%= t('confirm_delete') %>')"><button type="submit" class="danger"><%= t('delete') %></button></form>
            </div>
            <% } else { %>-<% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
  <% } %>
</div>
<%- include('partials/footer') %>
