<%- include('partials/header') %>
<style>
  .form-sec { font-size: .88rem; font-weight: 700; color: var(--ink); margin: 0 0 .9rem; }
  .form-sec.blocked { border-top: 1px solid var(--line-soft); padding-top: 1.2rem; }
  .help { font-size: .74rem; font-weight: 400; color: var(--muted); margin-top: .25rem; }
  .field input, .field select, .field textarea {
    border: 1px solid transparent;
    background: var(--line-soft);
    border-radius: 10px;
    padding: .6rem .8rem;
    min-height: 38px;
    font-size: .88rem;
    font-family: inherit;
    color: var(--ink);
    transition: background .15s, border-color .15s;
  }
  .field textarea { min-height: 76px; resize: vertical; }
  .field input::placeholder { color: var(--faint); }
  .field input:hover, .field select:hover, .field textarea:hover { border-color: var(--line); }
  .field input:focus, .field select:focus, .field textarea:focus { background: var(--card); border-color: var(--brand-2); }
  .seg { display: flex; gap: .5rem; }
  .seg-opt {
    flex: 1; display: flex; align-items: center; justify-content: center; gap: .5rem;
    border: 1px solid transparent; background: var(--line-soft); border-radius: 10px;
    padding: .55rem .7rem; min-height: 38px; cursor: pointer;
    font-size: .85rem; font-weight: 600; color: var(--label);
    transition: background .15s, border-color .15s;
  }
  .seg-opt:hover { border-color: var(--line); }
  .seg-opt.on { border-color: var(--brand-2); background: var(--brand-soft); color: var(--brand); }
  .seg-opt input[type="radio"] { background: transparent; border: 0; padding: 0; min-height: 0; width: auto; height: auto; accent-color: var(--brand); }
  .seg-opt input[type="radio"]:hover, .seg-opt input[type="radio"]:focus { border: 0; background: transparent; }
  .empty-pick { font-size: .78rem; color: var(--muted); font-weight: 400; }
  @media (max-width: 640px) { .seg { flex-direction: column; } }
</style>
<div class="page-head">
  <div><h1><%= t('add') %> &mdash; <%= t('nav_apv_replacement') %></h1></div>
  <div class="page-actions"><a class="btn" href="/ui/approvals/replacement-off">&larr; <%= t('back') %></a></div>
</div>
<% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>
<div class="card card-pad" style="max-width:720px;">
  <form method="post" action="/ui/approvals/replacement-off/new">
    <div class="form-sec"><%= t('ro_original_date') %></div>
    <div class="form-grid">
      <% if (companies) { %>
      <div class="field full"><%= t('company_label') %>
        <select name="companyId" id="companyId" required>
          <option value="" <%= companyId ? '' : 'selected' %>>-</option>
          <% companies.forEach(function(c) { %>
            <option value="<%= c.id %>" <%= companyId === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
        <div class="help"><%= t('company_first_help') %></div>
      </div>
      <% } else { %>
      <input type="hidden" name="companyId" value="<%= companyId %>" />
      <% } %>
      <div class="field full"><%= t('employee') %>
        <% if (employees.length) { %>
        <select name="user_id" required>
          <option value="">-</option>
          <% employees.forEach(function(e) { %>
            <option value="<%= e.id %>" <%= String(row.user_id) === String(e.id) ? 'selected' : '' %>><%= e.namaLengkap %><% if (e.nip) { %> &middot; <%= e.nip %><% } %></option>
          <% }) %>
        </select>
        <% } else { %>
        <div class="empty-pick"><%= t('ro_no_employee') %></div>
        <input type="hidden" name="user_id" value="" />
        <% } %>
      </div>
      <div class="field"><%= t('ro_original_date') %>
        <input type="date" name="original_date" required value="<%= row.original_date %>" />
        <div class="help"><%= t('ro_draft_help') %></div>
      </div>
      <div class="field"><%= t('schedule_label') %>
        <select name="schedule_id">
          <option value="">-</option>
          <% schedules.forEach(function(s) { %>
            <option value="<%= s.id %>" <%= String(row.schedule_id) === String(s.id) ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
        <div class="help"><%= t('ro_schedule_help') %></div>
      </div>
      <div class="field"><%= t('ro_off_type') %>
        <div class="seg">
          <label class="seg-opt <%= !row.is_half_day ? 'on' : '' %>">
            <input type="radio" name="is_half_day" value="off" <%= !row.is_half_day ? 'checked' : '' %> /><%= t('no') %>
          </label>
          <label class="seg-opt <%= row.is_half_day ? 'on' : '' %>">
            <input type="radio" name="is_half_day" value="on" <%= row.is_half_day ? 'checked' : '' %> /><%= t('yes') %>
          </label>
        </div>
      </div>
      <div class="field"><%= t('ro_expiry_days') %>
        <input type="number" name="expiry_days" min="1" max="365" step="1" value="<%= row.expiry_days %>" placeholder="30" />
        <div class="help"><%= t('ro_expiry_help') %></div>
      </div>
      <div class="field full"><%= t('reason') %>
        <textarea name="reason" maxlength="500" rows="3"><%= row.reason %></textarea>
      </div>
    </div>

    <div class="form-actions">
      <button class="btn primary" type="submit" <%= employees.length ? '' : 'disabled' %>><%= t('save') %></button>
      <a class="btn" href="/ui/approvals/replacement-off"><%= t('cancel') %></a>
    </div>
  </form>
</div>
<script>
(function () {
  document.querySelectorAll('.seg-opt input').forEach(function (inp) {
    inp.addEventListener('change', function () {
      inp.closest('.seg-opt').classList.toggle('on', inp.checked);
    });
  });
  var co = document.getElementById('companyId');
  if (co) co.addEventListener('change', function () {
    location.href = location.pathname + (co.value ? '?companyId=' + encodeURIComponent(co.value) : '');
  });
})();
</script>
<%- include('partials/footer') %>
