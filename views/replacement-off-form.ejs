<%- include('partials/header') %>
<style>
  .field input, .field select, .field textarea {
    border: 1px solid transparent;
    background: var(--line-soft);
    border-radius: 10px;
    padding: .6rem .8rem;
    min-height: 38px;
    font-size: .88rem;
    font-family: inherit;
    color: var(--ink);
    transition: background .15s, border-color .15s;
  }
  .field input:not([type="checkbox"]):not([type="radio"]), .field select { height: 40px; }
  .field textarea { min-height: 76px; resize: vertical; }
  .field input::placeholder { color: var(--faint); }
  .field input:hover, .field select:hover, .field textarea:hover { border-color: var(--line); }
  .field input:focus, .field select:focus, .field textarea:focus { background: var(--card); border-color: var(--brand-2); }
  .field input[type="checkbox"] {
    background: transparent; border: 0; padding: 0; min-height: 0;
    width: 18px; height: 18px; accent-color: var(--brand);
  }
  .field input[type="checkbox"]:hover, .field input[type="checkbox"]:focus { border: 0; background: transparent; }
  .field input[type="checkbox"]:focus-visible { outline: 2px solid var(--brand-2); outline-offset: 2px; }
  .check {
    display: flex; align-items: center; gap: .6rem; height: 40px;
    padding: .6rem .8rem; border: 1px solid transparent; border-radius: 10px;
    background: var(--line-soft); cursor: pointer;
    font-weight: 400; font-size: .85rem; color: var(--ink);
    transition: border-color .15s;
  }
  .check:hover { border-color: var(--line); }
  .empty-pick { font-size: .78rem; color: var(--muted); font-weight: 400; }
</style>
<div class="page-head">
  <div><h1><%= t('add') %> &mdash; <%= t('nav_apv_replacement') %></h1></div>
  <div class="page-actions"><a class="btn" href="/ui/approvals/replacement-off">&larr; <%= t('back') %></a></div>
</div>
<% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>
<div class="card card-pad" style="max-width:720px;">
  <form method="post" action="/ui/approvals/replacement-off/new">
    <div class="form-grid">
      <% if (companies) { %>
      <div class="field full"><span class="field-label"><%= t('company_label') %><span class="info"><button type="button" class="info-btn" aria-label="<%= t('info_label') %>" aria-expanded="false" aria-describedby="tip-ro-company"><svg class="ico" aria-hidden="true" focusable="false"><use href="#ico-info"></use></svg></button><span class="info-pop" role="tooltip" id="tip-ro-company"><%= t('company_first_help') %></span></span></span>
        <select name="companyId" id="companyId" required>
          <option value="" <%= companyId ? '' : 'selected' %>>-</option>
          <% companies.forEach(function(c) { %>
            <option value="<%= c.id %>" <%= companyId === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <% } else { %>
      <input type="hidden" name="companyId" value="<%= companyId %>" />
      <% } %>
      <div class="field full"><%= t('employee') %>
        <% if (employees.length) { %>
        <select name="user_id" required>
          <option value="">-</option>
          <% employees.forEach(function(e) { %>
            <option value="<%= e.id %>" <%= String(row.user_id) === String(e.id) ? 'selected' : '' %>><%= e.namaLengkap %><% if (e.nip) { %> &middot; <%= e.nip %><% } %></option>
          <% }) %>
        </select>
        <% } else { %>
        <div class="empty-pick"><%= t('ro_no_employee') %></div>
        <input type="hidden" name="user_id" value="" />
        <% } %>
      </div>
      <div class="field full"><span class="field-label"><%= t('ro_original_date') %><span class="info"><button type="button" class="info-btn" aria-label="<%= t('info_label') %>" aria-expanded="false" aria-describedby="tip-ro-date"><svg class="ico" aria-hidden="true" focusable="false"><use href="#ico-info"></use></svg></button><span class="info-pop" role="tooltip" id="tip-ro-date"><%= t('ro_draft_help') %></span></span></span>
        <% const _orig = row.original_date || ''; %>
        <span class="date-field" data-date-field>
          <span class="date-show<%= _orig ? '' : ' is-empty' %>" aria-hidden="true"><span data-date-show><%= _orig || 'yyyy-mm-dd' %></span><svg class="ico" aria-hidden="true" focusable="false"><use href="#ico-calendar"></use></svg></span>
          <input type="date" class="date-native" name="original_date" required value="<%= _orig %>" aria-label="<%= t('ro_original_date') %>" />
        </span>
      </div>
      <div class="field"><span class="field-label"><%= t('ro_half_day') %><span class="info"><button type="button" class="info-btn" aria-label="<%= t('info_label') %>" aria-expanded="false" aria-describedby="tip-ro-half"><svg class="ico" aria-hidden="true" focusable="false"><use href="#ico-info"></use></svg></button><span class="info-pop" role="tooltip" id="tip-ro-half"><%= t('ro_half_day_help') %></span></span></span>
        <label class="check">
          <input type="checkbox" name="is_half_day" value="on" <%= row.is_half_day ? 'checked' : '' %> />
          <span><%= t('ro_half_day_label') %></span>
        </label>
      </div>
      <div class="field"><span class="field-label"><%= t('ro_expiry_days') %><span class="info"><button type="button" class="info-btn" aria-label="<%= t('info_label') %>" aria-expanded="false" aria-describedby="tip-ro-expiry"><svg class="ico" aria-hidden="true" focusable="false"><use href="#ico-info"></use></svg></button><span class="info-pop" role="tooltip" id="tip-ro-expiry"><%= t('ro_expiry_help') %></span></span></span>
        <input type="number" name="expiry_days" min="1" max="365" step="1" value="<%= row.expiry_days %>" placeholder="30" />
      </div>
      <div class="field full"><%= t('reason') %>
        <textarea name="reason" maxlength="500" rows="3"><%= row.reason %></textarea>
      </div>
    </div>

    <div class="form-actions">
      <button class="btn primary" type="submit" <%= employees.length ? '' : 'disabled' %>><%= t('save') %></button>
      <a class="btn" href="/ui/approvals/replacement-off"><%= t('cancel') %></a>
    </div>
  </form>
</div>
<script>
(function () {
  var co = document.getElementById('companyId');
  if (co) co.addEventListener('change', function () {
    location.href = location.pathname + (co.value ? '?companyId=' + encodeURIComponent(co.value) : '');
  });
})();
</script>
<%- include('partials/footer') %>
