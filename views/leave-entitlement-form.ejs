<%- include('partials/header') %>
<style>
  .form-sec { font-size: .88rem; font-weight: 700; color: var(--ink); margin: 0 0 .9rem; }
  .form-sec.blocked { border-top: 1px solid var(--line-soft); padding-top: 1.2rem; }
  .field input, .field select {
    border: 1px solid transparent;
    background: var(--line-soft);
    border-radius: 10px;
    padding: .6rem .8rem;
    min-height: 38px;
    font-size: .88rem;
    font-family: inherit;
    color: var(--ink);
    transition: background .15s, border-color .15s;
  }
  .field input::placeholder { color: var(--faint); }
  .field input:hover, .field select:hover { border-color: var(--line); }
  .field input:focus, .field select:focus { background: var(--card); border-color: var(--brand-2); }
  .field input:disabled, .field select:disabled { opacity: .6; }
</style>
<div class="page-head">
  <div><h1><%= row && row.id ? t('edit') : t('add') %> — <%= t('nav_leave_entitlements') %></h1></div>
  <div class="page-actions"><a class="btn" href="/ui/leave-entitlements">← <%= t('back') %></a></div>
</div>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<div class="card card-pad" style="max-width:720px;">
  <form method="post" action="<%= row && row.id ? '/ui/leave-entitlements/' + row.id : '/ui/leave-entitlements' %>">
    <div class="form-sec"><%= t('section_identity') %></div>
    <div class="form-grid">
      <% if (typeof companies !== 'undefined' && companies) { %>
      <div class="field full"><span class="field-label"><%= t('company_label') %><span class="info"><button type="button" class="info-btn" aria-label="<%= t('info_label') %>" aria-expanded="false" aria-describedby="tip-le-company"><svg class="ico" aria-hidden="true" focusable="false"><use href="#ico-info"></use></svg></button><span class="info-pop" role="tooltip" id="tip-le-company"><%= t('company_first_help') %></span></span></span>
        <select name="companyId" id="companyId" required <%= row ? 'disabled' : '' %>>
          <option value="" <%= companyId ? '' : 'selected' %>>-</option>
          <% companies.forEach(function(c) { %>
            <option value="<%= c.id %>" <%= companyId === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <% } %>
      <div class="field full">
        <% if (row) { %>
        <span class="field-label"><%= t('employee') %><span class="info"><button type="button" class="info-btn" aria-label="<%= t('info_label') %>" aria-expanded="false" aria-describedby="tip-le-emp"><svg class="ico" aria-hidden="true" focusable="false"><use href="#ico-info"></use></svg></button><span class="info-pop" role="tooltip" id="tip-le-emp"><%= t('ent_employee_locked_help') %></span></span></span>
        <% } else if (!companyId) { %>
        <span class="field-label"><%= t('employee') %><span class="info"><button type="button" class="info-btn" aria-label="<%= t('info_label') %>" aria-expanded="false" aria-describedby="tip-le-emp"><svg class="ico" aria-hidden="true" focusable="false"><use href="#ico-info"></use></svg></button><span class="info-pop" role="tooltip" id="tip-le-emp"><%= t('company_first_help') %></span></span></span>
        <% } else { %>
        <span class="field-label"><%= t('employee') %></span>
        <% } %>
        <select name="user_id" id="userId" required <%= (row || !companyId) ? 'disabled' : '' %>>
          <option value="">-</option>
          <% employees.forEach(function(v) { %><option value="<%= v.id %>" <%= row && row.userId === v.id ? 'selected' : '' %>><%= v.namaLengkap %> (<%= v.email %>)</option><% }) %>
        </select>
      </div>
      <div class="field full">
        <% if (row) { %>
        <span class="field-label">Tipe cuti<span class="info"><button type="button" class="info-btn" aria-label="<%= t('info_label') %>" aria-expanded="false" aria-describedby="tip-le-type"><svg class="ico" aria-hidden="true" focusable="false"><use href="#ico-info"></use></svg></button><span class="info-pop" role="tooltip" id="tip-le-type"><%= t('ent_type_locked_help') %></span></span></span>
        <% } else { %>
        <span class="field-label">Tipe cuti</span>
        <% } %>
        <select name="leave_type_id" required <%= (row || !companyId) ? 'disabled' : '' %>>
          <option value="">-</option>
          <% leaveTypes.forEach(function(v) { %><option value="<%= v.id %>" <%= row && row.leaveTypeId === v.id ? 'selected' : '' %>><%= v.name %></option><% }) %>
        </select>
      </div>
    </div>

    <div class="form-sec blocked">Kuota tahunan</div>
    <div class="form-grid">
      <div class="field"><span class="field-label">Tahun<span class="info"><button type="button" class="info-btn" aria-label="<%= t('info_label') %>" aria-expanded="false" aria-describedby="tip-le-year"><svg class="ico" aria-hidden="true" focusable="false"><use href="#ico-info"></use></svg></button><span class="info-pop" role="tooltip" id="tip-le-year"><%= t('ent_year_locked_help') %></span></span></span>
        <input type="number" name="year" min="2000" max="2100" required readonly value="<%= row ? row.year : new Date().getFullYear() %>" />
      </div>
      <div class="field"><span class="field-label">Entitlement<span class="info"><button type="button" class="info-btn" aria-label="<%= t('info_label') %>" aria-expanded="false" aria-describedby="tip-le-value"><svg class="ico" aria-hidden="true" focusable="false"><use href="#ico-info"></use></svg></button><span class="info-pop" role="tooltip" id="tip-le-value"><%= t('ent_value_help') %></span></span></span>
        <input type="number" name="entitlement" min="0" step="0.5" required value="<%= row ? Number(row.entitlement) : 0 %>" />
      </div>
    </div>

    <div class="form-actions">
      <button class="btn primary" type="submit" <%= !row && !companyId ? 'disabled' : '' %>><%= t('save') %></button>
      <a class="btn" href="/ui/leave-entitlements"><%= t('cancel') %></a>
    </div>
  </form>
</div>
<script>
(function () {
  var co = document.getElementById('companyId');
  if (co) co.addEventListener('change', function () {
    location.href = location.pathname + (co.value ? '?companyId=' + encodeURIComponent(co.value) : '');
  });
})();
</script>
<%- include('partials/footer') %>
