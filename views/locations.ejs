<%- include('partials/header') %>
<h1><%= t('nav_locations') %></h1>
<table>
  <thead>
    <tr>
      <th><%= t('code') %></th>
      <th><%= t('name') %></th>
      <th><%= t('latitude') %></th>
      <th><%= t('longitude') %></th>
      <th><%= t('radius') %></th>
      <th><%= t('status') %></th>
    </tr>
  </thead>
  <tbody>
    <% rows.forEach(function(r) { %>
      <tr>
        <td><%= r.code %></td>
        <td><%= r.name %></td>
        <td><%= r.latitude %></td>
        <td><%= r.longitude %></td>
        <td><%= r.radius %></td>
        <td><span class="badge <%= r.status === 'Y' ? 'approved' : 'inactive' %>"><%= r.status %></span></td>
      </tr>
    <% }) %>
    <% if (rows.length === 0) { %><tr><td colspan="6" class="empty"><%= t('empty') %></td></tr><% } %>
  </tbody>
</table>
<%- include('partials/footer') %>
