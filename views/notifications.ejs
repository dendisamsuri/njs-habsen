<%- include('partials/header') %>
<h1><%= t('nav_notifications') %></h1>
<table>
  <thead>
    <tr>
      <th><%= t('title') %></th>
      <th><%= t('reason') %></th>
      <th><%= t('date') %></th>
      <th><%= t('status') %></th>
    </tr>
  </thead>
  <tbody>
    <% rows.forEach(function(r) { %>
      <tr>
        <td><%= r.title %></td>
        <td><%= r.body %></td>
        <td><%= r.created_at %></td>
        <td><span class="badge <%= r.is_read ? 'approved' : 'pending' %>"><%= r.is_read ? 'read' : t('unread') %></span></td>
      </tr>
    <% }) %>
    <% if (rows.length === 0) { %><tr><td colspan="4" class="empty"><%= t('empty') %></td></tr><% } %>
  </tbody>
</table>
<%- include('partials/footer') %>
