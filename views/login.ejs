<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= t('login_title') %></title>
  <script>
    (function () {
      var m;
      try { m = localStorage.getItem('theme'); } catch (e) { m = null; }
      if (m !== 'light' && m !== 'dark') {
        m = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-theme', m);
    })();
  </script>
  <style>
    :root {
      --brand:#1d4ed8; --ink:#0f172a; --muted:#64748b; --line:#e2e8f0;
      --bg:#eef2f7; --surface:#ffffff; --label:#334155; --field-line:#cbd5e1;
      --alert-bg:#fef2f2; --alert-line:#fecaca; --alert-ink:#991b1b; --lang-hover:#eff6ff;
      --input-bg:#ffffff;
    }
    [data-theme="dark"] {
      --brand:#3b82f6; --ink:#e5eaf3; --muted:#97a3b8; --line:#263349;
      --bg:#0b1220; --surface:#131c2e; --label:#cbd5e1; --field-line:#33445f;
      --alert-bg:#2d1515; --alert-line:#7f1d1d; --alert-ink:#fca5a5; --lang-hover:#1a2540;
      --input-bg:#172033;
    }
    * { box-sizing: border-box; }
    html { color-scheme: light; }
    [data-theme="dark"] { color-scheme: dark; }
    ::placeholder { color: var(--muted); opacity: 1; }
    body { margin:0; font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif; min-height:100vh; display:grid; place-items:center; padding:1.2rem;
      background:var(--bg); color:var(--ink); }
    .wrap { width:100%; max-width:880px; display:grid; grid-template-columns:1.1fr 1fr; background:var(--surface); border:1px solid var(--line); border-radius:20px; overflow:hidden; box-shadow:0 16px 40px -18px rgba(15,23,42,.35); }
    .hero { background:#122547; color:#fff; padding:2.2rem; display:flex; flex-direction:column; justify-content:space-between; gap:1.5rem; }
    .hero .mark { width:46px;height:46px;border-radius:13px;display:grid;place-items:center;background:#2563eb;font-size:1.2rem;font-weight:800; }
    .hero h2 { margin:.9rem 0 .4rem; font-size:1.5rem; letter-spacing:-.02em; }
    .hero p { margin:0; color:#c7d6f5; font-size:.9rem; }
    .hero ul { margin:1.2rem 0 0; padding:0; list-style:none; display:grid; gap:.55rem; font-size:.86rem; color:#dbe6ff; }
    .form-side { padding:2.2rem 2rem; }
    .form-side h1 { margin:0; font-size:1.25rem; letter-spacing:-.01em; }
    .form-side .sub { color:var(--muted); font-size:.86rem; margin:.3rem 0 1.2rem; }
    label { display:block; font-size:.82rem; font-weight:600; color:var(--label); margin:.8rem 0 .3rem; }
    input { width:100%; padding:.65rem .75rem; border:1px solid var(--field-line); background:var(--input-bg); border-radius:10px; font-size:.95rem; color:var(--ink); }
    input:focus { border-color:var(--brand); outline:2px solid rgba(29,78,216,.2); }
    .pw { position:relative; }
    .pw input { padding-right:2.7rem; }
    .pw-toggle { position:absolute; right:.3rem; top:50%; transform:translateY(-50%); margin:0; width:2.1rem; height:2.1rem; padding:0; display:grid; place-items:center; background:transparent; border:0; border-radius:8px; color:var(--muted); }
    .pw-toggle:hover { color:var(--ink); filter:none; background:var(--lang-hover); }
    .pw-toggle:focus-visible { outline:2px solid rgba(29,78,216,.35); outline-offset:1px; }
    .pw-toggle svg { width:1.1rem; height:1.1rem; fill:none; stroke:currentColor; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
    .pw-toggle svg[hidden] { display:none; }
    button { margin-top:1.1rem; width:100%; padding:.7rem; background:var(--brand); color:#fff; border:0; border-radius:10px; font-size:.95rem; font-weight:700; cursor:pointer; }
    button:hover { filter:brightness(1.06); }
    .error { background:var(--alert-bg); border:1px solid var(--alert-line); color:var(--alert-ink); padding:.6rem .75rem; border-radius:10px; font-size:.85rem; margin-bottom:.6rem; }
    .langs { margin-top:1.2rem; display:flex; justify-content:space-between; align-items:center; font-size:.8rem; }
    .langs a { color:var(--brand); text-decoration:none; font-weight:700; padding:.3rem .6rem; border:1px solid var(--line); border-radius:999px; margin-left:.4rem; }
    .langs a:hover { background:var(--lang-hover); }
    @media (max-width:760px){ .wrap{grid-template-columns:1fr;} .hero{display:none;} }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="hero">
      <div>
        <div class="mark">A</div>
        <h2>Absensi Admin</h2>
        <p><%= t('login_title') %></p>
        <ul>
          <li>Dashboard kehadiran harian</li>
          <li>Persetujuan cuti &amp; izin</li>
          <li>Lokasi, jadwal &amp; laporan</li>
        </ul>
      </div>
      <div style="font-size:.75rem;color:#9db4e5;">Aman · Cepat · Multi-perusahaan</div>
    </div>
    <div class="form-side">
      <h1><%= t('sign_in') %></h1>
      <div class="sub"><%= t('login_title') %></div>
      <% if (error) { %><div class="error"><%= error %></div><% } %>
      <form method="post" action="/ui/login">
        <label><%= t('email') %></label>
        <input type="email" name="email" required autocomplete="username" placeholder="admin@demo.test" />
        <label><%= t('password') %></label>
        <div class="pw">
          <input id="pw" type="password" name="password" required autocomplete="current-password" placeholder="••••••••" />
          <button type="button" class="pw-toggle" data-pw-toggle aria-controls="pw" aria-pressed="false"
            data-label-show="<%= t('show_password') %>" data-label-hide="<%= t('hide_password') %>"
            aria-label="<%= t('show_password') %>" title="<%= t('show_password') %>">
            <svg data-eye-on viewBox="0 0 24 24" aria-hidden="true"><path d="M1.5 12S4.5 5 12 5s10.5 7 10.5 7-3 7-10.5 7S1.5 12 1.5 12z" /><circle cx="12" cy="12" r="3" /></svg>
            <svg data-eye-off viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M2 2l20 20" /><path d="M6.7 6.8C4 8.6 1.5 12 1.5 12S4.5 19 12 19c1.9 0 3.6-.6 5-1.4M9.9 5.2A9.6 9.6 0 0 1 12 5c7.5 0 10.5 7 10.5 7a17 17 0 0 1-3.2 4" /><path d="M9.5 9.8a3 3 0 0 0 4.2 4.2" /></svg>
          </button>
        </div>
        <button type="submit"><%= t('sign_in') %></button>
      </form>
      <div class="langs">
        <span style="color:var(--muted);">Language</span>
        <span><a href="<%= langUrl('id') %>">ID</a><a href="<%= langUrl('en') %>">EN</a></span>
      </div>
    </div>
  </div>
  <script>
    (function () {
      var btn = document.querySelector('[data-pw-toggle]');
      var input = btn && document.getElementById(btn.getAttribute('aria-controls'));
      if (!btn || !input) return;
      var eyeOn = btn.querySelector('[data-eye-on]');
      var eyeOff = btn.querySelector('[data-eye-off]');
      btn.addEventListener('click', function () {
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        eyeOn.hidden = show;
        eyeOff.hidden = !show;
        btn.setAttribute('aria-pressed', String(show));
        var label = show ? btn.dataset.labelHide : btn.dataset.labelShow;
        btn.setAttribute('aria-label', label);
        btn.setAttribute('title', label);
        if (show) input.focus();
      });
    })();
  </script>
</body>
</html>
