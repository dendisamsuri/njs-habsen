<%- include('partials/header') %>
<h1><%= t('nav_process_logs') %> — <%= today %></h1>
<form method="get" action="/ui/process-logs" style="margin-bottom:.75rem;">
  <label><%= t('date') %></label>
  <input type="date" name="date" value="<%= today %>" style="padding:.4rem;border:1px solid #d1d5db;border-radius:4px;" />
  <button class="small" type="submit" style="margin-left:.4rem;">OK</button>
</form>
<% if (!data || !data.employees || data.employees.length === 0) { %>
  <div class="empty"><%= t('empty') %></div>
<% } else { %>
<table>
  <thead>
    <tr>
      <th><%= t('employee') %></th>
      <th><%= t('location') %></th>
      <th>Attempts</th>
      <th>OK</th>
      <th>Fail</th>
      <th><%= t('started') %></th>
      <th><%= t('flow_id') %></th>
    </tr>
  </thead>
  <tbody>
    <% data.employees.forEach(function(e) { %>
      <tr>
        <td><%= e.nama_lengkap %></td>
        <td><%= e.lokasi_nama || '-' %></td>
        <td><%= e.attempt_count %></td>
        <td><%= e.success_count %></td>
        <td><%= e.failed_count %></td>
        <td><%= new Date(e.latest_started_at).toISOString().slice(0,16).replace('T',' ') %></td>
        <td style="font-size:.7rem;"><%= (e.attempts[0] && e.attempts[0].flow_id) || '-' %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
<% } %>
<%- include('partials/footer') %>
