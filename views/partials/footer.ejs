      EMP_LEAD_INVALID: 'Direct supervisor is invalid or outside this company.',
      EMP_DOB_INVALID: 'Invalid date of birth (use YYYY-MM-DD).',
      ENT_USER_REQUIRED: 'Select an employee first.',
      ENT_TYPE_REQUIRED: 'Select a leave type first.',
      ENT_YEAR_INVALID: 'Invalid year.',
      ENT_VALUE_INVALID: 'Invalid leave entitlement amount.',
      ENT_USER_INVALID: 'Employee not found in this company.',
      ENT_TYPE_INVALID: 'Leave type not found in this company.',
      ENT_COMPANY_MISMATCH: 'Employee and leave type must be in the same company.',
      ENT_BELOW_TAKEN: 'Entitlement cannot be less than leave already taken.',
      ENT_HAS_TAKEN: 'Cannot delete because leave has already been taken.',
      LEAVE_ALREADY_PROCESSED: 'Request already processed or status changed.',
      LEAVE_NOT_DIRECT_REPORT: 'You are not this employee\u2019s direct supervisor.',
      LEAVE_INVALID_TRANSITION: 'Request status already changed, reload the page.',
      LEAVE_COMMENT_INVALID: 'Rejection comment must be 5–500 characters.',
      APPROVAL_SIDE_EFFECT_FAILED: 'Failed to process the request, try again.',
      LEAVE_NOT_FOUND: 'Request is no longer available.',
      LEAVE_SELF_APPROVAL_DENIED: 'Cannot approve your own request.',
      LEAVE_INVALID_ACTOR: 'You are not authorized to decide this request.',
      NOT_FOUND: 'Data not found.',
      NAME_REQUIRED: 'Name is required.',
      NAME_TOO_LONG: 'Name is too long.',
      CODE_INVALID: 'Invalid code (2–30 chars).',
      NAME_EXISTS: 'Name/code already used.',
      ADDRESS_REQUIRED: 'Full address is required.',
      ADDRESS_TOO_LONG: 'Address must be at most 500 characters.',
      LAT_INVALID: 'Invalid latitude.',
      LON_INVALID: 'Invalid longitude.',
      RADIUS_INVALID: 'Radius must be greater than 0.',
      CODE_REQUIRED: 'Invalid code.',
      err_in_use: 'Record is still in use, cannot change or delete.',
      err_name_exists: 'Name/code already used in this company.',
      err_date_exists: 'Date already registered as a holiday.',
      err_company_required: 'Select a company first.',
      err_name_required: 'Name is required.',
      err_name_too_long: 'Name must be at most 120 characters.',
      err_code_invalid: 'Code must be 2–30 chars: letters, numbers, dot, dash, underscore.',
      err_time_invalid: 'Time must be in HH:MM format.',
      err_tolerance_invalid: 'Tolerance must be 0–600 minutes.',
      err_detail_required: 'Enable at least one working day.',
      err_date_invalid: 'Date must be a valid YYYY-MM-DD date.',
      err_category_invalid: 'Invalid leave category.',
      err_timezone_invalid: 'Invalid timezone.',
      err_save_failed: 'Failed to save record.',
      saved: 'Settings saved.',
      save: 'Saved successfully.',
      create: 'Added successfully.',
      update: 'Updated successfully.',
      delete: 'Deleted successfully.',
      toggle: 'Status changed.',
      approve: 'Request approved.',
      reject: 'Request rejected.',
    },
  };
  var localeKey = (typeof locale !== 'undefined' && msgMap[locale]) ? locale : 'id';
  var dict = msgMap[localeKey];

  var params = new URLSearchParams(window.location.search);
  var flagErr = params.get('error');
  var flagDetail = params.get('detail');
  var flagOk = params.get('ok') || (params.get('saved') === '1' ? 'saved' : null);
  var fired = false;

  if (flagErr) {
    var errMsg = dict[flagErr] || flagErr;
    if (flagDetail) errMsg += ' — ' + flagDetail;
    toast(errMsg, 'err');
    fired = true;
  }
  if (flagOk) {
    toast(dict[flagOk] || flagOk, 'ok');
    fired = true;
  }
  // One-shot flags: strip from URL so refresh does not re-fire the popup.
  if (fired) {
    try {
      var cleanUrl = new URL(window.location.href);
      cleanUrl.searchParams.delete('ok');
      cleanUrl.searchParams.delete('error');
      cleanUrl.searchParams.delete('detail');
      cleanUrl.searchParams.delete('saved');
      var cleanQs = cleanUrl.searchParams.toString();
      window.history.replaceState(null, '', cleanUrl.pathname + (cleanQs ? '?' + cleanQs : '') + cleanUrl.hash);
    } catch (e) {}
  }
  // Fall back to inline alerts (form re-renders, settings success) when no flag fired.
  if (!fired) {
    var okAlert = document.querySelector('.alert.ok');
    if (okAlert) toast(okAlert.textContent.trim(), 'ok');
    var errAlert = document.querySelector('.alert.error');
    if (errAlert) toast(errAlert.textContent.trim(), 'err');
  }
})();
</script>
</body>
