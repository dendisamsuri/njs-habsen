      err_in_use: 'Data masih dipakai, tidak bisa diubah atau dihapus.',
      err_name_exists: 'Nama/kode sudah dipakai di perusahaan ini.',
      err_date_exists: 'Tanggal sudah terdaftar sebagai hari libur.',
      err_company_required: 'Pilih perusahaan terlebih dahulu.',
      err_name_required: 'Nama wajib diisi.',
      err_name_too_long: 'Nama maksimal 120 karakter.',
