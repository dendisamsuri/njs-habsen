      err_timezone_invalid: 'Zona waktu tidak valid.',
      err_save_failed: 'Data tidak berhasil disimpan.',
      saved: 'Pengaturan tersimpan.',
      save: 'Berhasil disimpan.',
      create: 'Berhasil ditambahkan.',
      update: 'Berhasil diperbarui.',
      delete: 'Berhasil dihapus.',
      toggle: 'Status berhasil diubah.',
      approve: 'Pengajuan disetujui.',
      reject: 'Pengajuan ditolak.',
    },
    en: {
      COMPANY_REQUIRED: 'Select a company first.',
