      ENT_COMPANY_MISMATCH: 'Karyawan dan tipe cuti harus dalam satu perusahaan.',
      ENT_BELOW_TAKEN: 'Jatah tidak boleh lebih kecil dari cuti yang sudah terpakai.',
      ENT_HAS_TAKEN: 'Tidak bisa dihapus karena sudah ada cuti yang terpakai.',
      LEAVE_ALREADY_PROCESSED: 'Pengajuan sudah diproses atau statusnya berubah.',
      LEAVE_NOT_DIRECT_REPORT: 'Anda bukan atasan langsung karyawan ini.',
      LEAVE_INVALID_TRANSITION: 'Status pengajuan sudah berubah, muat ulang halaman.',
      LEAVE_COMMENT_INVALID: 'Komentar penolakan wajib 5–500 karakter.',
      APPROVAL_SIDE_EFFECT_FAILED: 'Gagal memproses pengajuan, coba lagi.',
      LEAVE_NOT_FOUND: 'Pengajuan sudah tidak tersedia.',
      LEAVE_SELF_APPROVAL_DENIED: 'Tidak bisa menyetujui pengajuan sendiri.',
      LEAVE_INVALID_ACTOR: 'Anda tidak berwenang memutuskan pengajuan ini.',
      NOT_FOUND: 'Data tidak ditemukan.',
      NAME_REQUIRED: 'Nama wajib diisi.',
      NAME_TOO_LONG: 'Nama terlalu panjang.',
      CODE_INVALID: 'Kode tidak valid (2–30 karakter).',
      NAME_EXISTS: 'Nama/kode sudah dipakai.',
      ADDRESS_REQUIRED: 'Alamat lengkap wajib diisi.',
      ADDRESS_TOO_LONG: 'Alamat maksimal 500 karakter.',
      LAT_INVALID: 'Latitude tidak valid.',
