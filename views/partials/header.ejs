<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Absensi</title>
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, sans-serif; background: #f4f6f8; display: flex; min-height: 100vh; }
    nav { width: 220px; background: #111827; color: #e5e7eb; padding: 1rem .75rem; flex-shrink: 0; }
    nav .brand { font-weight: 700; font-size: 1rem; margin-bottom: 1rem; padding: 0 .5rem; }
    nav a { display: block; color: #d1d5db; text-decoration: none; padding: .45rem .5rem; border-radius: 4px; font-size: .88rem; margin-bottom: 2px; }
    nav a:hover, nav a.active { background: #1f2937; color: #fff; }
    nav .foot { margin-top: 1.5rem; border-top: 1px solid #374151; padding-top: .75rem; font-size: .8rem; }
    nav .foot form { margin: 0; }
    nav .foot button { background: none; border: 1px solid #4b5563; color: #e5e7eb; padding: .3rem .6rem; border-radius: 4px; cursor: pointer; width: 100%; }
    main { flex: 1; padding: 1.25rem 1.5rem; overflow-x: auto; }
    h1 { font-size: 1.15rem; margin: 0 0 1rem; }
    table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 6px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
    th, td { text-align: left; padding: .55rem .7rem; font-size: .85rem; border-bottom: 1px solid #eef0f3; }
    th { background: #f9fafb; font-weight: 600; color: #374151; }
    tr:last-child td { border-bottom: 0; }
    .badge { display: inline-block; padding: .1rem .45rem; border-radius: 999px; font-size: .72rem; background: #e5e7eb; }
    .badge.pending { background: #fef3c7; color: #92400e; }
    .badge.approved, .badge.waiting_hr { background: #d1fae5; color: #065f46; }
    .badge.rejected, .badge.cancelled, .badge.expired { background: #fee2e2; color: #991b1b; }
    .badge.inactive { background: #fee2e2; color: #991b1b; }
    .empty { padding: 1.5rem; text-align: center; color: #6b7280; }
    form.inline { display: inline; }
    button.small { padding: .2rem .55rem; font-size: .78rem; border-radius: 4px; border: 1px solid #d1d5db; background: #fff; cursor: pointer; }
    button.small.ok { background: #059669; border-color: #059669; color: #fff; }
    button.small.no { background: #dc2626; border-color: #dc2626; color: #fff; }
    .langs { font-size: .8rem; margin-bottom: .75rem; }
    .langs a { color: #1a56db; text-decoration: none; margin-right: .4rem; }
    .meta { color: #6b7280; font-size: .8rem; margin-bottom: .75rem; }
  </style>
</head>
<body>
  <nav>
    <div class="brand">Absensi Admin</div>
    <% nav.forEach(function(item) { %>
      <a href="<%= item.href %>" class="<%= (typeof page !== 'undefined' && item.href.indexOf(page) !== -1) ? 'active' : '' %>"><%= item.label %></a>
    <% }) %>
    <div class="foot">
      <% if (typeof user !== 'undefined' && user) { %>
        <div style="padding:0 .5rem .5rem;font-size:.78rem;color:#9ca3af;"><%= user.nama_lengkap %></div>
      <% } %>
      <form method="post" action="/ui/logout"><button type="submit"><%= t('logout') %></button></form>
    </div>
  </nav>
  <main>
    <div class="langs">
      <a href="<%= langUrl('id') %>">ID</a>
      <a href="<%= langUrl('en') %>">EN</a>
    </div>
