<%- include('partials/header') %>
<h1><%= t('nav_schedules') %></h1>
<table>
  <thead>
    <tr>
      <th><%= t('code') %></th>
      <th><%= t('name') %></th>
      <th><%= t('active') %></th>
      <th>Details</th>
    </tr>
  </thead>
  <tbody>
    <% rows.forEach(function(r) { %>
      <tr>
        <td><%= r.code %></td>
        <td><%= r.name %></td>
        <td><span class="badge <%= r.is_active ? 'approved' : 'inactive' %>"><%= r.is_active ? 'Y' : 'N' %></span></td>
        <td>
          <% r.details.forEach(function(d) { %>
            <div style="font-size:.78rem;"><%= d.day %>: <%= d.time_in %>–<%= d.time_out %> (±<%= d.tolerance %>m)</div>
          <% }) %>
        </td>
      </tr>
    <% }) %>
    <% if (rows.length === 0) { %><tr><td colspan="4" class="empty"><%= t('empty') %></td></tr><% } %>
  </tbody>
</table>
<%- include('partials/footer') %>
