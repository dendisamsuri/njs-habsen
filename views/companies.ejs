<%- include('partials/header') %>
<%
  const activeCount = rows.filter(function(r){ return r.status === 'ACTIVE'; }).length;
%>
<div class="page-head">
  <div><h1><%= t('nav_companies') %></h1><p class="sub"><%= activeCount %> aktif · <%= rows.length %> total</p></div>
  <div class="page-actions"><a class="btn primary" href="/ui/companies/new"><%= t('add') %></a></div>
</div>
<% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>
<div class="card">
  <div class="table-toolbar"><b><%= t('company_list') %></b><span class="count"><%= rows.length %> <%= t('rows_label') %></span></div>
  <% if (!rows.length) { %><div class="empty"><%= t('empty_companies') %></div><% } else { %>
  <div class="table-wrap"><table class="tbl">
    <thead><tr><th>No</th><th><%= t('code') %></th><th><%= t('company_name') %></th><th style="text-align:center;"><%= t('status') %></th><th style="text-align:center;"><%= t('actions') %></th></tr></thead>
    <tbody>
      <% rows.forEach(function(r, i) { %>
        <tr>
          <td class="mono"><%= i + 1 %></td>
          <td class="mono"><%= r.code %></td>
          <td><b><%= r.name %></b></td>
          <td style="text-align:center;"><span class="badge <%= r.status === 'ACTIVE' ? 'green' : 'red' %>"><%= r.status %></span></td>
          <td style="text-align:center;">
            <div class="row-actions">
              <a class="btn" href="/ui/companies/<%= r.id %>/edit"><%= t('edit') %></a>
              <form method="post" action="/ui/companies/<%= r.id %>/toggle" style="display:inline"><button type="submit"><%= t('toggle') %></button></form>
              <form method="post" action="/ui/companies/<%= r.id %>/delete" style="display:inline" onsubmit="return confirm('<%= t('confirm_delete') %>')"><button type="submit" class="danger"><%= t('delete') %></button></form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
  <% } %>
</div>
<%- include('partials/footer') %>
