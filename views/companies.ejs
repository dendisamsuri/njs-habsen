<%- include('partials/header') %>
<div class="page-head"><div><h1><%= t('nav_companies') %></h1><p class="sub"><%= rows.length %> perusahaan</p></div></div>
<div class="card">
  <div class="table-toolbar"><b>Daftar perusahaan</b><span class="count"><%= rows.length %> <%= t('rows_label') %></span></div>
  <% if (!rows.length) { %><div class="empty"><%= t('empty_companies') %></div><% } else { %>
  <div class="table-wrap"><table class="tbl">
    <thead><tr><th><%= t('code') %></th><th><%= t('name') %></th><th><%= t('status') %></th></tr></thead>
    <tbody>
      <% rows.forEach(function(r) { %>
        <tr>
          <td class="mono"><%= r.code %></td>
          <td><b><%= r.name %></b></td>
          <td><span class="badge <%= r.status === 'ACTIVE' ? 'green' : 'red' %>"><%= r.status %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
  <% } %>
</div>
<%- include('partials/footer') %>
