<%- include('partials/header') %>
<h1><%= t('nav_leaves') %></h1>
<table>
  <thead>
    <tr>
      <th><%= t('employee') %></th>
      <th><%= t('name') %></th>
      <th><%= t('date') %></th>
      <th>Days</th>
      <th><%= t('status') %></th>
      <th><%= t('reason') %></th>
    </tr>
  </thead>
  <tbody>
    <% rows.forEach(function(r) { %>
      <tr>
        <td><%= r.nama_lengkap %></td>
        <td><%= r.jenis %></td>
        <td><%= r.start_date %> → <%= r.end_date %></td>
        <td><%= r.total_days %></td>
        <td><span class="badge <%= r.status %>"><%= r.status %></span></td>
        <td><%= r.reason %></td>
      </tr>
    <% }) %>
    <% if (rows.length === 0) { %><tr><td colspan="6" class="empty"><%= t('empty') %></td></tr><% } %>
  </tbody>
</table>
<%- include('partials/footer') %>
