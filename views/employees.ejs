<%- include('partials/header') %>
<div class="page-head"><div><h1><%= t('nav_employees') %></h1><p class="sub"><%= rows.length %> total</p></div><% if (canEdit) { %><div class="page-actions"><a class="btn primary" href="/ui/employees/new"><%= t('add') %></a></div><% } %></div>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<div class="card">
  <div class="table-toolbar"><b>Daftar employees</b><span class="count"><%= rows.length %> <%= t('rows_label') %></span></div>
  <% if (!rows.length) { %><div class="empty"><%= t('empty_users') %></div><% } else { %>
  <div class="table-wrap"><table class="tbl"><thead><tr><th><%= t('name') %></th><th><%= t('email') %></th><th>NIP</th><th><%= t('role') %></th><th><%= t('position') %></th><th><%= t('location') %></th><th>Jadwal</th><th><%= t('lead') %></th><th><%= t('active') %></th><th><%= t('actions') %></th></tr></thead>
  <tbody><% rows.forEach(function(r) { %><tr><td><b><%= r.nama_lengkap %></b></td><td><%= r.email %></td><td class="mono"><%= r.nip %></td><td><span class="badge gray"><%= r.role %></span></td><td><%= r.posisi %></td><td><%= r.lokasi %></td><td><%= r.jadwal %></td><td><%= r.lead %></td><td><span class="badge <%= r.is_active ? 'green' : 'red' %>"><%= r.is_active ? 'Y' : 'N' %></span></td><td><% if (canEdit) { %><div class="row-actions"><a class="btn" href="/ui/employees/<%= r.id %>/edit"><%= t('edit') %></a><form method="post" action="/ui/employees/<%= r.id %>/toggle" style="display:inline"><button type="submit"><%= t('toggle') %></button></form><form method="post" action="/ui/employees/<%= r.id %>/delete" style="display:inline" onsubmit="return confirm('<%= t('confirm_delete') %>')"><button type="submit" class="danger"><%= t('delete') %></button></form></div><% } else { %>-<% } %></td></tr><% }) %></tbody>
  </table></div><% } %>
</div>
<%- include('partials/footer') %>
