<%- include('partials/header') %>
<h1><%= t('nav_users') %></h1>
<table>
  <thead>
    <tr>
      <th><%= t('name') %></th>
      <th><%= t('email') %></th>
      <th>NIP</th>
      <th><%= t('role') %></th>
      <th><%= t('position') %></th>
      <th><%= t('location') %></th>
      <th><%= t('lead') %></th>
      <th><%= t('active') %></th>
    </tr>
  </thead>
  <tbody>
    <% rows.forEach(function(r) { %>
      <tr>
        <td><%= r.nama_lengkap %></td>
        <td><%= r.email %></td>
        <td><%= r.nip %></td>
        <td><%= r.role %></td>
        <td><%= r.posisi %></td>
        <td><%= r.lokasi %></td>
        <td><%= r.lead %></td>
        <td><span class="badge <%= r.is_active ? 'approved' : 'inactive' %>"><%= r.is_active ? 'Y' : 'N' %></span></td>
      </tr>
    <% }) %>
    <% if (rows.length === 0) { %><tr><td colspan="8" class="empty"><%= t('empty') %></td></tr><% } %>
  </tbody>
</table>
<%- include('partials/footer') %>
