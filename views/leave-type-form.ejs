<%- include('partials/header') %>
<style>
  .form-sec { font-size: .88rem; font-weight: 700; color: var(--ink); margin: 0 0 .9rem; }
  .form-sec.blocked { border-top: 1px solid var(--line-soft); padding-top: 1.2rem; }
  .help { font-size: .74rem; font-weight: 400; color: var(--muted); margin-top: .25rem; }
  .field input, .field select {
    border: 1px solid transparent;
    background: var(--line-soft);
    border-radius: 10px;
    padding: .6rem .8rem;
    min-height: 38px;
    transition: background .15s, border-color .15s;
  }
  .field input::placeholder { color: var(--faint); }
  .field input:hover, .field select:hover { border-color: var(--line); }
  .field input:focus, .field select:focus { background: var(--card); border-color: var(--brand-2); }
  .seg { display: flex; gap: .5rem; }
  .seg-opt {
    flex: 1; display: flex; align-items: center; justify-content: center; gap: .5rem;
    border: 1px solid transparent; background: var(--line-soft); border-radius: 10px;
    padding: .55rem .7rem; min-height: 38px; cursor: pointer;
    font-size: .85rem; font-weight: 600; color: var(--label);
    transition: background .15s, border-color .15s;
  }
  .seg-opt:hover { border-color: var(--line); }
  .seg-opt.on { border-color: var(--brand-2); background: var(--brand-soft); color: var(--brand); }
</style>
<div class="page-head">
  <div><h1><%= row && row.id ? t('edit') : t('add') %> — <%= t('nav_leave_types') %></h1></div>
  <div class="page-actions"><a class="btn" href="/ui/leave-types">← <%= t('back') %></a></div>
</div>
<% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>
<div class="card card-pad" style="max-width:640px;">
  <form method="post" action="<%= row && row.id ? '/ui/leave-types/' + row.id : '/ui/leave-types' %>">
    <div class="form-sec"><%= t('section_identity') %></div>
    <div class="form-grid">
      <% if (typeof companies !== 'undefined' && companies) { %>
      <div class="field full"><%= t('company_label') %>
        <select name="companyId" required>
          <% companies.forEach(function(c) { %>
            <option value="<%= c.id %>" <%= companyId === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <% } %>
      <div class="field full"><%= t('name') %>
        <input name="name" required maxlength="120" value="<%= row && row.name ? row.name : '' %>" />
      </div>
      <div class="field full"><%= t('code') %>
        <input name="code" maxlength="30" value="<%= row && row.code ? row.code : '' %>" placeholder="<%= t('code_ph') %>" />
        <div class="help"><%= t('code_help') %></div>
      </div>
      <div class="field full"><%= t('category') %>
        <select name="category" required>
          <option value="LEAVE" <%= !row || row.category === 'LEAVE' ? 'selected' : '' %>>LEAVE</option>
          <option value="PERMIT" <%= row && row.category === 'PERMIT' ? 'selected' : '' %>>PERMIT</option>
          <option value="SICK" <%= row && row.category === 'SICK' ? 'selected' : '' %>>SICK</option>
        </select>
        <div class="help"><%= t('category_help') %></div>
      </div>
    </div>

    <div class="form-sec blocked"><%= t('deductible') %></div>
    <div class="seg">
      <label class="seg-opt <%= !row || row.is_deductible !== 'N' ? 'on' : '' %>">
        <input type="radio" name="is_deductible" value="Y" <%= !row || row.is_deductible !== 'N' ? 'checked' : '' %> /><%= t('yes') %>
      </label>
      <label class="seg-opt <%= row && row.is_deductible === 'N' ? 'on' : '' %>">
        <input type="radio" name="is_deductible" value="N" <%= row && row.is_deductible === 'N' ? 'checked' : '' %> /><%= t('no') %>
      </label>
    </div>

    <div class="form-sec blocked"><%= t('attachment_req') %></div>
    <div class="seg">
      <label class="seg-opt <%= row && row.requires_attachment === 'Y' ? 'on' : '' %>">
        <input type="radio" name="requires_attachment" value="Y" <%= row && row.requires_attachment === 'Y' ? 'checked' : '' %> /><%= t('yes') %>
      </label>
      <label class="seg-opt <%= !row || row.requires_attachment !== 'Y' ? 'on' : '' %>">
        <input type="radio" name="requires_attachment" value="N" <%= !row || row.requires_attachment !== 'Y' ? 'checked' : '' %> /><%= t('no') %>
      </label>
    </div>

    <div class="form-sec blocked"><%= t('active_label') %></div>
    <div class="seg">
      <label class="seg-opt <%= !row || row.status !== 'N' ? 'on' : '' %>">
        <input type="radio" name="status" value="Y" <%= !row || row.status !== 'N' ? 'checked' : '' %> /><%= t('yes') %>
      </label>
      <label class="seg-opt <%= row && row.status === 'N' ? 'on' : '' %>">
        <input type="radio" name="status" value="N" <%= row && row.status === 'N' ? 'checked' : '' %> /><%= t('no') %>
      </label>
    </div>

    <div class="form-actions">
      <button class="btn primary" type="submit"><%= t('save') %></button>
      <a class="btn" href="/ui/leave-types"><%= t('cancel') %></a>
    </div>
  </form>
</div>
<script>
(function () {
  document.querySelectorAll('.seg').forEach(function (seg) {
    seg.querySelectorAll('input[type="radio"]').forEach(function (r) {
      r.addEventListener('change', function () {
        seg.querySelectorAll('.seg-opt').forEach(function (l) {
          l.classList.toggle('on', l.querySelector('input').checked);
        });
      });
    });
  });
})();
</script>
<%- include('partials/footer') %>
