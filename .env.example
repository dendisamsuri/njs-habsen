# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL="mysql://root:root@localhost:3306/njs_habsen?timezone=Z"

# JWT
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# Auth throttle
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=15

# CORS (contoh production di belakang Cloudflare Tunnel)
CORS_ORIGINS=http://localhost:3000,https://sistemlvn.web.id

# Face recognition
FACE_RECOGNITION_URL=http://localhost:5001
FACE_RECOGNITION_TIMEOUT=10

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152
