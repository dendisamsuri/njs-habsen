# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL="mysql://root:root@localhost:3306/njs_habsen?timezone=Z"

# JWT
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# Auth throttle
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=15

# CORS (contoh production di belakang Cloudflare Tunnel)
CORS_ORIGINS=http://localhost:3000,https://sistemlvn.web.id

# Cookie sesi admin. Default secure; set false hanya untuk dev http://localhost.
COOKIE_SECURE=false

# Log error lengkap (bawa PII dari query Prisma). Default hanya nama error.
LOG_ERROR_STACKS=0

# Face recognition
FACE_RECOGNITION_URL=http://localhost:5001
FACE_RECOGNITION_TIMEOUT=10
# Masa berlaku token URL foto wajah (detik, maks 604800)
FACE_PHOTO_URL_TTL=86400

# Seed
# 1 = isi data demo (dev). Kosongkan di produksi.
SEED_DEMO=1
# Dipakai hanya saat tabel user masih kosong. Password minimal 12 karakter.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Admin
DEMO_PASSWORD=Password123!

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152
